# Copy to .env and fill in. Never commit .env.
# MODE=mock (default) keeps everything on this machine: HubSpot and Slack are
# answered in-process. MODE=live talks to the real services. See docs/live-setup.md.
MODE=mock
LOG_LEVEL=info
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=.data/copilot.db
QUEUE_CONCURRENCY=2

# Optional HMAC secrets. When set, webhooks must send X-Signature: sha256=<hex of the raw body>.
FORM_WEBHOOK_SECRET=
EMAIL_WEBHOOK_SECRET=

# Claude. Optional: without a key every lead goes through the fallback rules to human review.
# In mock mode a key here means real Claude calls (paid) with mocked HubSpot and Slack.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=20000
AI_MIN_CONFIDENCE=0.7

# HubSpot private app access token (live mode). Scopes are listed in docs/live-setup.md.
HUBSPOT_ACCESS_TOKEN=
# Optional, for clickable deal links on the Slack card.
HUBSPOT_PORTAL_ID=
HUBSPOT_APP_URL=https://app.hubspot.com
HUBSPOT_PIPELINE_ID=default
HUBSPOT_STAGE_NEW=appointmentscheduled
HUBSPOT_STAGE_APPROVED=qualifiedtobuy
HUBSPOT_STAGE_NOT_A_FIT=closedlost
DEAL_MERGE_WINDOW_DAYS=30

# Slack app from slack-app-manifest.yml (live mode). Bot token and Socket Mode app token.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SALES_CHANNEL=#sales
SLACK_SUPPORT_CHANNEL=#support
SLACK_ALERTS_CHANNEL=#sales-ops
# Optional Slack user id to mention on high value leads and reminders.
SLACK_SALES_LEAD_USER_ID=

REMIND_AFTER_MINUTES=120
DIGEST_TIME=08:00
DIGEST_TIMEZONE=Africa/Johannesburg
SCHEDULER_TICK_SECONDS=60
# Extra personal mailbox domains that should never become HubSpot companies, comma separated.
FREE_MAIL_DOMAINS=
